        player.Character.Humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
    end
end)

-- [6] มองเห็น (ESP - ฆาตกรแดง / ผู้เล่นเขียว)
createToggle("โปรมองเห็น (ESP)", function(state)
    Toggles.ESP = state
    if not state then
        for _, p in pairs(Players:GetPlayers()) do
            if p.Character and p.Character:FindFirstChild("DioESP") then
                p.Character.DioESP:Destroy()
            end
        end
    end
end)

-- ==========================================
-- ระบบ Loop ทำงานเพื่อแก้บัคเวลาตาย/เกิดใหม่
-- ==========================================
RunService.Stepped:Connect(function()
    local char = player.Character
    if not char then return end
    local hum = char:FindFirstChild("Humanoid")
    local root = char:FindFirstChild("HumanoidRootPart")

    -- ล่องหน
    if Toggles.Invis then
        for _, part in pairs(char:GetDescendants()) do
            if part:IsA("BasePart") or part:IsA("Decal") then
                part.Transparency = 1
            end
        end
    end

    -- ทะลุกำแพง
    if Toggles.Noclip then
        for _, part in pairs(char:GetDescendants()) do
            if part:IsA("BasePart") and part.CanCollide then
                part.CanCollide = false
            end
        end
    end

    -- วิ่งไว และ กระโดดสูง (อัปเดตตลอดเวลาแม้เกิดใหม่)
    if hum then
        if Toggles.FastRun then
            hum.WalkSpeed = 100 -- ค่าความเร็ว (แก้ตรงนี้ได้)
        else
            if hum.WalkSpeed > 50 then hum.WalkSpeed = 16 end -- คืนค่าปกติ
        end

        if Toggles.HighJump then
            hum.UseJumpPower = true
            hum.JumpPower = Settings.JumpPower
        else
            if hum.JumpPower > 50 then hum.JumpPower = 50 end -- คืนค่าปกติ
        end
    end
end)

-- Loop สำหรับอัปเดต ESP
RunService.RenderStepped:Connect(function()
    if not Toggles.ESP then return end
    
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= player and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            local char = p.Character
            local highlight = char:FindFirstChild("DioESP")
            
            if not highlight then
                highlight = Instance.new("Highlight")
                highlight.Name = "DioESP"
                highlight.Parent = char
            end
            
            -- ตรวจสอบตัวร้าย (เช็คจากมีด หรือ ชื่อทีม)
            local isKiller = false
            local hasWeapon = char:FindFirstChild("Knife") or char:FindFirstChild("Melee") or (p:FindFirstChild("Backpack") and (p.Backpack:FindFirstChild("Knife") or p.Backpack:FindFirstChild("Melee")))
            local isKillerTeam = p.Team and (p.Team.Name:lower():match("killer") or p.Team.Name:lower():match("murder"))
            
            if hasWeapon or isKillerTeam then
                isKiller = true
            end

            -- ตั้งสี ESP
            if isKiller then
                highlight.FillColor = Color3.fromRGB(255, 0, 0) -- สีแดง
                highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
            else
                highlight.FillColor = Color3.fromRGB(0, 255, 0) -- สีเขียว
                highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
            end
        end
    end
end)
