local function createToggle(text, callback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0.9, 0, 0, 35)
    btn.Position = UDim2.new(0.05, 0, 0, 0)
    btn.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    btn.BackgroundTransparency = 0.3
    btn.BorderColor3 = Color3.fromRGB(200, 150, 0)
    btn.Text = text .. " [ OFF ]"
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Font = Enum.Font.SourceSansBold
    btn.TextSize = 14
    
    local container = Instance.new("Frame")
    container.Size = UDim2.new(1, 0, 0, 35)
    container.BackgroundTransparency = 1
    btn.Parent = container
    container.Parent = mainFrame

    local state = false
    btn.MouseButton1Click:Connect(function()
        state = not state
        btn.Text = text .. (state and " [ ON ]" or " [ OFF ]")
        btn.TextColor3 = state and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(255, 255, 255)
        callback(state)
    end)
    return btn
end

local function createInput(placeholder, defaultVal, callback)
    local box = Instance.new("TextBox")
    box.Size = UDim2.new(0.9, 0, 0, 30)
    box.Position = UDim2.new(0.05, 0, 0, 0)
    box.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    box.BackgroundTransparency = 0.3
    box.BorderColor3 = Color3.fromRGB(200, 150, 0)
    box.PlaceholderText = placeholder
    box.Text = tostring(defaultVal)
    box.TextColor3 = Color3.fromRGB(255, 215, 0)
    box.Font = Enum.Font.SourceSansBold
    box.TextSize = 14
    
    local container = Instance.new("Frame")
    container.Size = UDim2.new(1, 0, 0, 30)
    container.BackgroundTransparency = 1
    box.Parent = container
    container.Parent = mainFrame

    box.FocusLost:Connect(function()
        local val = tonumber(box.Text)
        if val then callback(val) end
    end)
    return box
end

